{
  "name": "multi-agents-chat",
  "displayName": "Multi Agents Hub Chat",
  "description": "Send @hub prompts directly to your local Multi Agents orchestrator.",
  "version": "0.1.9",
  "publisher": "khang1604",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onUri",
    "onChatParticipant:multi-agents.hub"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "multi-agents.hub",
        "name": "hub",
        "fullName": "Multi Agents Hub",
        "description": "Send tasks directly to Hub; /agents, /status, /watch, /retry, /cancel",
        "isSticky": true,
        "commands": [
          {
            "name": "agents",
            "description": "List agents; no model calls"
          },
          {
            "name": "status",
            "description": "View the project's workflow"
          },
          {
            "name": "watch",
            "description": "Watch the active workflow"
          },
          {
            "name": "retry",
            "description": "Resume a blocked workflow; preserve the budget"
          },
          {
            "name": "cancel",
            "description": "Cancel the workflow; retain code/checkpoints"
          },
          {
            "name": "accept",
            "description": "Confirm applying code to project files"
          },
          {
            "name": "autoaccept",
            "description": "on/off/status: automatic acceptance for this project only"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "multi-agents.review",
        "title": "Multi Agents: Review changes"
      },
      {
        "command": "multi-agents.acceptAll",
        "title": "Multi Agents: Accept all"
      },
      {
        "command": "multi-agents.acceptFile",
        "title": "Multi Agents: Accept individual files"
      },
      {
        "command": "multi-agents.setup",
        "title": "Multi Agents: Quick Setup"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "multi-agents.review",
          "when": "false"
        },
        {
          "command": "multi-agents.acceptAll",
          "when": "false"
        },
        {
          "command": "multi-agents.acceptFile",
          "when": "false"
        }
      ]
    }
  }
}
